# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL, plain HTTP on port 8109. Not "localhost": inside the containers
# that name is the container itself, and PDFs load the page through this URL
# (*.localhost names resolve to this machine in browsers and on macOS).
ERPNEXT_URL=http://erp.localhost:8109
ERPNEXT_HOST=erp.localhost
SITE_ADDRESS=:80
HTTP_PORT=8109
HTTPS_PORT=8409
MAILPIT_PORT=8025

# Dev-only secrets and credentials.
DB_ROOT_PASSWORD=root
ERPNEXT_ADMIN_PASSWORD=admin12345
ERPNEXT_ADMIN_EMAIL=manager@example.com

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=erp@example.com
SMTP_FROM_NAME=ERPNext
