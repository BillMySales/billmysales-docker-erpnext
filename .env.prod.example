# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=erpnext

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below).
#TRAEFIK_HOST=erp.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of ERPNext (the site's host_name: links in emails and
# background jobs; applied on every `up`).
ERPNEXT_URL=https://erp.example.com
# REQUIRED. The host name of ERPNEXT_URL. The app containers resolve it to the
# Docker host (where Caddy or Traefik publishes the site), because PDFs load
# the page's styles and images through the public URL.
ERPNEXT_HOST=erp.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=erp.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
# Internal name of the Frappe site (its directory and database). Any domain
# works with it; don't change it after the first install. It must not be
# the name of an app (e.g. "erpnext").
#ERPNEXT_SITE=site

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED, use long random values: openssl rand -base64 24)
# ---------------------------------------------------------------------------
# MariaDB root: bench uses it to create the site's database and user (whose
# own password bench generates and keeps in the site config).
DB_ROOT_PASSWORD=
# Password of both the `Administrator` user and the first user (the
# ERPNEXT_ADMIN_EMAIL login, a System Manager). Set on the first install only.
ERPNEXT_ADMIN_PASSWORD=
ERPNEXT_ADMIN_EMAIL=
#ERPNEXT_ADMIN_NAME=Admin

# ---------------------------------------------------------------------------
# Company (setup wizard, applied only on the first install)
# ---------------------------------------------------------------------------
#ERPNEXT_COMPANY_NAME=My Company
# Abbreviation, appended to account and warehouse names (e.g. "Cash - MC").
#ERPNEXT_COMPANY_ABBR=MC
# Country name as in ERPNext (not an ISO code).
#ERPNEXT_COUNTRY=Chile
#ERPNEXT_CURRENCY=CLP
#ERPNEXT_TIMEZONE=America/Santiago
# Language code (es-CL, es, en, ...).
#ERPNEXT_LANG=es-CL
# Chart of accounts: "Standard", "Standard with Numbers" or a verified
# template of the country (Chile has none: its template is "unverified",
# which ERPNext doesn't offer).
#ERPNEXT_CHART_OF_ACCOUNTS=Standard
# First day of the fiscal year (MM-DD); the first one starts this year.
#ERPNEXT_FISCAL_YEAR_START=01-01

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Image tag. A newer version (also a new major version, e.g. v15 -> v16)
# runs `bench migrate` on the next `up`; an older one is refused. Back up first.
#ERPNEXT_VERSION=v16.36.0
# Custom image with extra Frappe apps, built with frappe_docker (see README).
#ERPNEXT_IMAGE=frappe/erpnext
#MARIADB_VERSION=11.8
#REDIS_VERSION=8.6
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Gunicorn processes and threads per process (rough sizing: workers =
# CPUs * 2 + 1 at most, each ~150-250 MiB).
#GUNICORN_WORKERS=2
#GUNICORN_THREADS=4
# Request timeout in seconds (Gunicorn and nginx).
#ERPNEXT_TIMEOUT=120
# Max upload size (nginx and Caddy).
#UPLOAD_MAX_SIZE=50M

# ---------------------------------------------------------------------------
# Mail (SMTP): the site's default outgoing server (used unless an Email
# Account in ERPNext is the default outgoing one).
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS, usually port 587) or none. No SMTPS (port 465) from the site
# config: for that, add an Email Account in ERPNext. Frappe also turns
# STARTTLS on whenever SMTP_USER is set.
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Default sender address and name.
#SMTP_FROM=
#SMTP_FROM_NAME=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#DB_MEMORY_LIMIT=1g
#BACKEND_MEMORY_LIMIT=1g
#WORKER_MEMORY_LIMIT=768m
#SCHEDULER_MEMORY_LIMIT=512m
#WEBSOCKET_MEMORY_LIMIT=256m
#FRONTEND_MEMORY_LIMIT=128m
#REDIS_CACHE_MAXMEMORY=192mb
#REDIS_CACHE_MEMORY_LIMIT=256m
#REDIS_QUEUE_MEMORY_LIMIT=256m
#SETUP_MEMORY_LIMIT=1536m
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=768m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
